# VideoBot Configuration
# Copy this file to .env and fill in your values
# NEVER commit real .env with secrets to Git!

# ==========================================
# REQUIRED: FFmpeg path
# ==========================================
# Windows: if ffmpeg not in system PATH, set full path
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# Linux/Docker: usually in PATH, or:
# FFMPEG_PATH=/usr/bin/ffmpeg

# ==========================================
# OPTIONAL: AI API Keys (for metadata generation)
# ==========================================
# Get from https://console.groq.com/keys
GROQ_API_KEY=

# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Correct model name (gpt-5.6-luna does NOT exist)
OPENAI_MODEL=gpt-4o-mini
OPENAI_CHAT_MODEL=gpt-4o-mini

# ==========================================
# OPTIONAL: YouTube
# ==========================================
# YouTube Data API v3 key (optional, for quota)
YOUTUBE_API_KEY=

# ==========================================
# Whisper / Transcription
# ==========================================
# base, small, medium, large-v3, large-v3-turbo
WHISPER_MODEL=base

# Number of parallel segment workers
SEGMENT_WORKERS=2

# ==========================================
# Video Encoding
# ==========================================
# low/medium/high (NVENC presets) or CPU preset
VIDEO_PRESET=high

# ==========================================
# Subtitles (defaults, can be overridden in UI)
# ==========================================
SUBTITLE_FONT=TikTok Sans
SUBTITLE_STYLE=normal
SUBTITLE_FONTSIZE=100
SUBTITLE_FONTCOLOR=white
SUBTITLE_POSITION_Y=1670
SUBTITLE_CAPITALIZE=1
SUBTITLE_BORDERW=3
SUBTITLE_BORDERCOLOR=black
SUBTITLE_BOX_BORDER=0
SUBTITLE_BOX_COLOR=black@0.8
SUBTITLE_SHADOW_X=2
SUBTITLE_SHADOW_Y=2
SUBTITLE_SHADOW_COLOR=black
SUBTITLE_WORDS_COUNT=3
SUBTITLE_WORD_FADE=1

# ==========================================
# Database (optional, for production)
# ==========================================
# DATABASE_URL=postgresql+asyncpg://user:pass@host/db
# REDIS_URL=redis://localhost:6379/0

# ==========================================
# YouTube OAuth
# ==========================================
# Place client_secret.json in project root
# Or set path: GOOGLE_CLIENT_SECRET_FILE=./client_secret.json